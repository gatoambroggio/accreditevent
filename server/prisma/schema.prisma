// AccreditEvent self-hosted — Schema completo (todas las entidades).
// IDs son String (24 hex, como Base44) para preservar IDs al migrar.
// Los campos denormalizados (company, event_id, person_email, etc.) se
// mantienen para que el motor de RLS filtre igual que los jsonc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password_hash   String
  full_name       String?
  role            String   @default("user")
  data            Json     @default("{}") // company, assigned_event_ids, allowed_paths
  email_verified  Boolean  @default(false)
  blocked         Boolean  @default(false)
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("users")
}

model OtpCode {
  id         String   @id @default(cuid())
  email      String
  code       String
  purpose    String   @default("register")
  expires_at DateTime
  consumed   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

// ─── Organización / catálogos ───
model Company {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String?  @unique
  description          String?
  logo_url             String?
  assigned_user_ids    String[] @default([])
  operator_allowed_paths String[] @default([])
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("companies")
}

model ProviderCompany {
  id            String   @id @default(cuid())
  name          String
  description   String?
  logo_url      String?
  cuit          String?
  address       String?
  responsible_name String?
  contact_phone String?
  contact_email String?
  insurance_kind String   @default("") // ART | AP | ""
  custom_fields Json     @default("{}")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("provider_companies")
}

model AccessLevel {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  description String?
  badge_prefix String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("access_levels")
}

model ParkingSector {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  description String?
  capacity    Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("parking_sectors")
}

model DocumentType {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("document_types")
}

model CustomField {
  id           String   @id @default(cuid())
  entity_name  String   // Person | Event | Accreditation | ...
  field_key    String
  field_label  String
  field_type   String   @default("text")
  options      Json?
  required     Boolean  @default(false)
  default_value String?
  description  String?
  is_active    Boolean  @default(true)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("custom_fields")
}

model RequirementItem {
  id               String   @id @default(cuid())
  name             String
  description      String?
  category         String?
  unit             String   @default("Unidad")
  requires_quantity Boolean @default(true)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("requirement_items")
}

model SystemSetting {
  id            String   @id @default(cuid())
  system_name   String?
  organization_name String?
  logo_url      String?
  theme         Json?    @default("{}")
  mail_from     String?
  mail_host     String?
  mail_port     Int?
  mail_user     String?
  mail_password String?
  whatsapp_token String?
  whatsapp_phone_id String?
  printer_personal String?
  printer_vehicular String?
  zones         Json?
  doors         Json?
  event_phases  Json?
  parking_sectors Json?
  employment_types Json?
  person_types  Json?
  default_grace_hours Int @default(4)
  role_access   Json?    @default("{}")
  enabled_modules Json? @default("{}")
  vision_ocr    Json?    @default("{}")  // {api_key, base_url, model} — OCR por LLM de visión
  mercadopago   Json?    @default("{}")  // {access_token, public_key, webhook_url, sandbox, back_url_base}
  bar_email_template String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("system_settings")
}

// ─── Eventos ───
model Event {
  id              String   @id @default(cuid())
  name            String
  venue           String?
  logo_url        String?
  company         String?
  start_at        DateTime?
  end_at          DateTime?
  show_days       Int      @default(1)
  armado_start    DateTime?
  armado_end      DateTime?
  desarme_start   DateTime?
  desarme_end     DateTime?
  status          String   @default("draft")
  grace_hours     Int      @default(4)
  pickup_date     DateTime?
  pickup_start_time String?
  pickup_end_time   String?
  pickup_address    String?
  pickup_lat        Float?
  pickup_lng        Float?
  assigned_user_ids String[] @default([])
  parking_capacities Json?  @default("{}")
  bar_sectors        Json?  @default("[]")
  custom_fields      Json?  @default("{}")
  insurance_non_repetition_clauses String[] @default([])
  insurance_insured_amount Float?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("events")
}

model EventCompanyApproval {
  id              String   @id @default(cuid())
  event_id        String
  event_name      String?
  company         String?
  provider_company String
  status          String   @default("pending")
  approved_by     String?
  load_start_date DateTime?
  load_end_date   DateTime?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([event_id])
  @@map("event_company_approvals")
}

// ─── Personas ───
model Person {
  id            String   @id @default(cuid())
  full_name     String
  document      String?
  tipo_vinculo  String   @default("empresa")
  company       String?
  productora    String?
  phone         String?
  email         String?
  person_type   String   @default("provider")
  employment_type String  @default("fijo")
  access_area    String?
  event_phases  String[] @default([])
  event_id      String?
  event_ids     String[] @default([])
  event_names   String[] @default([])
  notes         String?
  obra_social   String?
  carnet_obra_social String?
  emergency_contact_name String?
  emergency_contact_phone String?
  allergies     String?
  blood_type    String   @default("")
  coordinator_name String?
  status        String   @default("active")
  custom_fields Json?    @default("{}")
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@index([company])
  @@index([document])
  @@map("people")
}

model Accreditation {
  id            String   @id @default(cuid())
  event_id      String
  event_name    String?
  company       String?
  person_id     String
  person_name   String?
  person_type   String?
  person_email  String?
  badge_code    String   @unique
  area          String?
  access_level  String   @default("general")
  event_phases  String[] @default([])
  status        String   @default("active")
  block_reason  String?
  has_biometric Boolean  @default(false)
  delivered_personal  Boolean @default(false)
  delivered_vehicular Boolean @default(false)
  custom_fields Json?   @default("{}")
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@index([person_id])
  @@index([company])
  @@index([person_email])
  @@map("accreditations")
}

model Vehicle {
  id            String   @id @default(cuid())
  person_id     String
  person_name   String?
  company       String?
  vehicle_type  String   @default("auto")
  brand         String
  model         String
  plate         String
  color         String?
  parking_sector String?
  event_ids     String[] @default([])
  event_names   String[] @default([])
  status        String   @default("pending")
  notes         String?
  custom_fields Json?    @default("{}")
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([plate])
  @@map("vehicles")
}

// ─── Biometría ───
model Biometric {
  id            String   @id @default(cuid())
  accreditation_id String?
  person_id     String
  person_name   String?
  event_id      String?
  company       String?
  face_photo_url String?
  face_descriptor Float[]
  credential_id String?
  public_key    String?
  counter       Int      @default(0)
  challenge     String?
  status        String   @default("pending")
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([person_id])
  @@index([event_id])
  @@index([accreditation_id])
  @@map("biometrics")
}

// ─── Documentos ───
model Document {
  id            String   @id @default(cuid())
  person_id     String?
  person_name   String?
  event_id      String?
  company       String?
  document_type String
  original_name String
  file_url      String
  mime_type     String?
  size          Int      @default(0)
  status        String   @default("pending")
  review_note   String?
  reviewed_by   String?
  reviewed_at   DateTime?
  expires_at    DateTime?
  expiry_notified_at DateTime?
  custom_fields Json?    @default("{}")
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([person_id])
  @@index([event_id])
  @@index([company])
  @@map("documents")
}

// ─── Acceso ───
model AccessLog {
  id              String   @id @default(cuid())
  accreditation_id String
  person_name     String?
  badge_code      String?
  event_id        String?
  event_name      String?
  company         String?
  verified_by     String?
  pda_number      String?
  method          String   @default("manual")
  resource_type   String   @default("person")
  zone            String?
  door            String?
  result          String   @default("granted")
  denied_reason   String   @default("")
  access_level    String?
  created_at      DateTime @default(now())

  @@index([event_id])
  @@index([created_at])
  @@map("access_logs")
}

model PdaStation {
  id              String   @id @default(cuid())
  station_number  String   @unique
  label           String?
  assigned_event_id String?
  assigned_zone   String?
  assigned_sectors String[] @default([])
  event_id        String?
  event_name      String?
  company         String?
  operator_name   String?
  mode            String   @default("person")
  last_seen       DateTime?
  pending_sync    Int      @default(0)
  battery_level   Int?
  admin_pin       String   @default("1234")
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("pda_stations")
}

model OfflineAccessQueue {
  id        String   @id @default(cuid())
  pda_number String?
  payload   Json
  synced    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([pda_number, synced])
  @@map("offline_access_queue")
}

// ─── Solicitudes de proveedores ───
model ProviderRequest {
  id            String   @id @default(cuid())
  event_id      String
  event_name    String?
  company       String?
  person_id     String
  person_name   String?
  person_email  String?
  items         Json     @default("[]")
  status        String   @default("pending")
  notes         String?
  admin_notes   String?
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("provider_requests")
}

// ─── Operadores pendientes (invitaciones) ───
model PendingOperator {
  id            String   @id @default(cuid())
  email         String
  company       String?
  desired_role  String   @default("operador")
  assigned_event_ids String[] @default([])
  allowed_paths String[] @default([])
  invite_url    String?
  status        String   @default("pending")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([email, status])
  @@map("pending_operators")
}

// ─── Hardware: Dahua ───
model DahuaDevice {
  id            String   @id @default(cuid())
  serial_number String?
  name          String
  ip            String
  port          Int      @default(80)
  username      String   @default("admin")
  password      String
  api_key       String
  zone          String?
  door_channel  Int      @default(0)
  event_id      String?
  event_name    String?
  last_seen     DateTime?
  last_error    String?
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("dahua_devices")
}

model DahuaCommand {
  id           String   @id @default(cuid())
  device_id    String
  event_id     String?
  command_type String
  command_data String?
  person_id    String?
  person_name  String?
  status       String   @default("pending")
  result       String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([device_id])
  @@map("dahua_commands")
}

// ─── Hardware: ZKTeco ───
model ZKTecoDevice {
  id            String   @id @default(cuid())
  serial_number String
  name          String
  api_key       String
  zone          String?
  event_id      String?
  event_name    String?
  last_seen     DateTime?
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("zkteco_devices")
}

model ZKTecoCommand {
  id           String   @id @default(cuid())
  device_id    String
  event_id     String?
  command_type String
  command_data String
  person_id    String?
  person_name  String?
  status       String   @default("pending")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([device_id])
  @@map("zkteco_commands")
}

// ─── Auditoría ───
model AuditLog {
  id         String   @id @default(cuid())
  actor_name String?
  actor_id   String?
  action     String
  entity    String
  entity_id String?
  detail     String?
  created_at DateTime @default(now())

  @@index([entity, entity_id])
  @@map("audit_logs")
}

// ─── Venta de entradas (ticketera) ───
model TicketSale {
  id            String   @id @default(cuid())
  event_id      String
  event_name    String?
  company       String?
  enabled       Boolean  @default(false)
  open_at       DateTime?
  close_at      DateTime?
  description   String?
  address       String?
  terms         String?
  image_url       String?
  validation_stages Json?
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([event_id])
  @@map("ticket_sales")
}

model TicketType {
  id                 String   @id @default(cuid())
  event_id           String
  event_name         String?
  company            String?
  name               String
  description        String?
  price              Float
  capacity           Int      @default(0)
  sold               Int      @default(0)
  limit_per_purchase Int      @default(10)
  status             String   @default("active")
  sort_order         Int      @default(0)
  created_by_id      String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([event_id])
  @@map("ticket_types")
}

model Ticket {
  id              String   @id @default(cuid())
  event_id        String
  event_name      String?
  company         String?
  ticket_type_id  String
  ticket_type_name String?
  buyer_name      String
  buyer_dni       String?
  buyer_email     String?
  buyer_phone     String?
  quantity        Int      @default(1)
  unit_price      Float    @default(0)
  total           Float    @default(0)
  status          String   @default("pending") // pending|paid|used|refunded|cancelled
  payment_id      String?
  qr_code         String   @unique
  qr_secret       String?
  stages_passed   String[] @default([])
  used_at         DateTime?
  verified_by     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([event_id])
  @@index([status])
  @@index([ticket_type_id])
  @@index([buyer_email])
  @@map("tickets")
}

// ─── Barras (POS de bebida/comida) ───
model Bar {
  id            String   @id @default(cuid())
  name          String
  event_id      String
  event_name    String?
  company       String?
  location      String?
  sectors       Json?    @default("[]")
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("bars")
}

model BarProduct {
  id            String   @id @default(cuid())
  bar_id        String
  bar_name      String?
  event_id      String
  event_name    String?
  company       String?
  name          String
  category      String?
  price         Float
  sector_prices Json?    @default("{}")
  sort_order    Int      @default(0)
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([bar_id])
  @@index([event_id])
  @@map("bar_products")
}

model EventProduct {
  id            String   @id @default(cuid())
  event_id      String
  event_name    String?
  company       String?
  name          String
  category      String?
  price         Float
  sector_prices Json?    @default("{}")
  sort_order    Int      @default(0)
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([event_id])
  @@map("event_products")
}

model BarSale {
  id              String   @id @default(cuid())
  bar_id          String
  bar_name        String?
  event_id        String
  event_name      String?
  company         String?
  operator_name   String?
  items           Json?    @default("[]")
  total           Float    @default(0)
  payment_method  String   @default("cash")
  payment_id      String?
  client_uuid     String?
  point_intent_id String?
  point_device_id String?
  manual_confirm  Boolean  @default(false)
  status          String   @default("paid")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([bar_id])
  @@index([event_id])
  @@index([status])
  @@map("bar_sales")
}

model BarOperator {
  id            String   @id @default(cuid())
  username      String   @unique
  password_hash String
  full_name     String?
  bar_id        String
  bar_name      String?
  event_id      String?
  event_name    String?
  company       String?
  blocked       Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([bar_id])
  @@map("bar_operators")
}

model BarTablet {
  id            String   @id @default(cuid())
  device_id     String
  alias         String?
  bar_id        String
  bar_name      String?
  event_id      String?
  event_name    String?
  company       String?
  operator_id   String?
  operator_name String?
  last_seen     DateTime?
  battery_level Int?
  charging      Boolean  @default(false)
  pending_sync  Int      @default(0)
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([device_id])
  @@index([bar_id])
  @@map("bar_tablets")
}

model BarPosDevice {
  id         String   @id @default(cuid())
  device_id  String
  alias      String
  bar_id     String
  bar_name   String?
  event_id   String?
  event_name String?
  company    String?
  status     String   @default("active")
  last_used  DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([bar_id])
  @@map("bar_pos_devices")
}

// ─── Caja de barras (apertura / retiro / cierre) ───
model BarCashMovement {
  id               String   @id @default(cuid())
  bar_id           String
  bar_name         String?
  event_id         String
  event_name       String?
  company          String?
  type             String   @default("withdraw")
  amount           Float    @default(0)
  operator_id      String?
  operator_name    String?
  responsible_name String?
  responsible_dni  String?
  note             String?
  balance_after    Float?
  status           String   @default("active")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([bar_id])
  @@index([event_id])
  @@index([type])
  @@map("bar_cash_movements")
}