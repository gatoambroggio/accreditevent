{
  "name": "Accreditation",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Evento asociado"
    },
    "event_name": {
      "type": "string",
      "description": "Nombre del evento (denormalizado)"
    },
    "company": {
      "type": "string",
      "description": "Empresa del evento (denormalizado para RLS)"
    },
    "person_id": {
      "type": "string",
      "description": "Persona acreditada"
    },
    "person_name": {
      "type": "string",
      "description": "Nombre de la persona (denormalizado)"
    },
    "person_type": {
      "type": "string",
      "description": "Tipo de persona (denormalizado)"
    },
    "person_email": {
      "type": "string",
      "description": "Email de la persona (denormalizado para RLS)"
    },
    "badge_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de credencial"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea de trabajo principal asignada"
    },
    "access_level": {
      "type": "string",
      "default": "general",
      "description": "Zona(s) de acceso asignadas (pueden ser m\u00faltiples, separadas por coma)"
    },
    "event_phases": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "armado",
          "dia_evento",
          "dia_1",
          "dia_2",
          "dia_3",
          "dia_4",
          "dia_5",
          "dia_6",
          "desarme"
        ]
      },
      "default": [],
      "description": "Fases/d\u00edas del evento en las que participa (d\u00eda_1 .. d\u00eda_6 seg\u00fan show_days del evento)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "revoked"
      ],
      "default": "active",
      "description": "Estado de la acreditaci\u00f3n"
    },
    "block_reason": {
      "type": "string",
      "description": "Raz\u00f3n/motivo del bloqueo o denegaci\u00f3n de acceso"
    },
    "has_biometric": {
      "type": "boolean",
      "default": false,
      "description": "Indica si tiene biometr\u00eda registrada"
    },
    "delivered_personal": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la credencial personal fue impresa/entregada"
    },
    "delivered_vehicular": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la credencial vehicular fue impresa/entregada"
    },
    "custom_fields": {
      "type": "object",
      "description": "Campos personalizados definidos por el administrador",
      "default": {}
    }
  },
  "required": [
    "event_id",
    "person_id",
    "badge_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operador"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "pda"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "data.person_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "empresa"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operador"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "empresa"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    }
  }
}