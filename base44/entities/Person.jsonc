{
  "name": "Person",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre completo"
    },
    "document": {
      "type": "string",
      "description": "Documento de identidad"
    },
    "tipo_vinculo": {
      "type": "string",
      "enum": [
        "empresa",
        "autonomo"
      ],
      "default": "empresa",
      "description": "Tipo de v\u00ednculo: empleado de empresa o persona aut\u00f3noma"
    },
    "company": {
      "type": "string",
      "description": "Empresa o raz\u00f3n social del proveedor"
    },
    "productora": {
      "type": "string",
      "description": "Productora del evento (denormalizado para RLS)"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email de contacto"
    },
    "person_type": {
      "type": "string",
      "default": "provider",
      "description": "Tipo de persona"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "fijo",
        "eventual"
      ],
      "default": "fijo",
      "description": "Tipo de contrataci\u00f3n del empleado"
    },
    "access_area": {
      "type": "string",
      "description": "\u00c1rea de acceso asignada (general, backstage, tecnica, vip, etc.)"
    },
    "event_phases": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "armado",
          "dia_evento",
          "desarme"
        ]
      },
      "default": [],
      "description": "Fases del evento en las que participa el empleado"
    },
    "event_id": {
      "type": "string",
      "description": "Evento al que pertenece la persona"
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de eventos asignados al empleado (puede trabajar en varios)"
    },
    "event_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nombres de eventos (denormalizado)"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas"
    },
    "custom_fields": {
      "type": "object",
      "description": "Campos personalizados definidos por el administrador",
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "active",
      "description": "Estado de la persona"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.productora": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.productora": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.productora": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.productora": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}