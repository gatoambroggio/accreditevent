{
  "name": "ProviderCompany",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la empresa proveedora"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n o rubro de la empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo de la empresa"
    },
    "cuit": {
      "type": "string",
      "description": "CUIT de la empresa (11 d\u00edgitos)"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n fiscal de la empresa"
    },
    "responsible_name": {
      "type": "string",
      "description": "Nombre completo del responsable de la empresa"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto de la empresa"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Email de contacto de la empresa"
    },
    "insurance_kind": {
      "type": "string",
      "enum": [
        "ART",
        "AP",
        ""
      ],
      "default": "",
      "description": "Tipo de seguro que corresponde a la empresa: ART (Aseguradora de Riesgos del Trabajo, sin monto) o AP (Accidentes Personales, con monto)"
    },
    "custom_fields": {
      "type": "object",
      "description": "Campos personalizados definidos por el administrador",
      "default": {}
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.name": "{{user.data.company}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "empresa"
              }
            },
            {
              "data.name": "{{user.data.company}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    }
  }
}