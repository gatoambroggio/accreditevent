{
  "name": "Biometric",
  "type": "object",
  "properties": {
    "accreditation_id": {
      "type": "string",
      "description": "Acreditaci\u00f3n asociada (opcional para registro de proveedores)"
    },
    "person_id": {
      "type": "string",
      "description": "Persona asociada"
    },
    "person_name": {
      "type": "string",
      "description": "Nombre de la persona (denormalizado)"
    },
    "face_photo_url": {
      "type": "string",
      "description": "URL de la foto de rostro capturada con c\u00e1mara web"
    },
    "face_descriptor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vector de 128 dimensiones del rostro (face-api.js)"
    },
    "credential_id": {
      "type": "string",
      "description": "ID de credencial WebAuthn (base64url) \u2014 legacy"
    },
    "public_key": {
      "type": "string",
      "description": "Clave p\u00fablica COSE (base64) \u2014 legacy"
    },
    "counter": {
      "type": "number",
      "default": 0,
      "description": "Contador de reproducci\u00f3n \u2014 legacy"
    },
    "challenge": {
      "type": "string",
      "description": "Challenge temporal pendiente \u2014 legacy"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ],
      "default": "pending",
      "description": "Estado del registro biom\u00e9trico"
    }
  },
  "required": [
    "person_id"
  ]
}