{
  "name": "Bar",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la barra"
    },
    "event_id": {
      "type": "string",
      "description": "Evento al que pertenece la barra"
    },
    "event_name": {
      "type": "string",
      "description": "Nombre del evento (denormalizado)"
    },
    "company": {
      "type": "string",
      "description": "Empresa productora (denormalizado para RLS)"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n de la barra dentro del evento"
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Sectores/ubicaciones que atiende la barra (ej. General, VIP). El POS usa un selector para cambiar los precios seg\u00fan el sector elegido."
    },
    "afip": {
      "type": "object",
      "description": "Configuraci\u00f3n AFIP propia de la barra. El CUIT, certificado y raz\u00f3n social se heredan de la empresa productora (Company.afip); ac\u00e1 se define el punto de venta (numeraci\u00f3n independiente por barra) y un modo opcional que sobrescribe el modo default de la empresa.",
      "properties": {
        "modo_override": {
          "type": "string",
          "enum": [
            "production",
            "sandbox",
            "disabled"
          ],
          "description": "Modo de facturaci\u00f3n que sobrescribe el default de la empresa. Si no se setea, la barra hereda el modo de la empresa productora."
        },
        "pto_vta": {
          "type": "number",
          "description": "Punto de venta AFIP propio de esta barra (numeraci\u00f3n independiente). Si no se setea, la venta queda sin facturar (afip_estado=none)."
        }
      },
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Estado de la barra"
    }
  },
  "required": [
    "name",
    "event_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "control"
          }
        },
        {
          "user_condition": {
            "role": "pda"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "barra"
              }
            },
            {
              "id": "{{user.data.bar_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "barra"
              }
            },
            {
              "id": "{{user.data.bar_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        }
      ]
    }
  }
}