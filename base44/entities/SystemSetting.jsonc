{
  "name": "SystemSetting",
  "type": "object",
  "properties": {
    "system_name": {
      "type": "string",
      "description": "Nombre del sistema mostrado en la barra lateral"
    },
    "organization_name": {
      "type": "string",
      "description": "Nombre de la organizaci\u00f3n"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logo del sistema"
    },
    "theme": {
      "type": "object",
      "description": "Personalizaci\u00f3n visual completa del sistema (colores, tipograf\u00eda, formato)",
      "properties": {
        "primary": {
          "type": "string",
          "description": "Color primario (hex)"
        },
        "accent": {
          "type": "string",
          "description": "Color de acento (hex)"
        },
        "background": {
          "type": "string",
          "description": "Color de fondo (hex)"
        },
        "sidebar_bg": {
          "type": "string",
          "description": "Fondo de barra lateral (hex)"
        },
        "sidebar_fg": {
          "type": "string",
          "description": "Texto de barra lateral (hex)"
        },
        "heading_font": {
          "type": "string",
          "description": "Fuente de t\u00edtulos"
        },
        "body_font": {
          "type": "string",
          "description": "Fuente de cuerpo"
        },
        "radius": {
          "type": "number",
          "description": "Radio de bordes (rem)"
        }
      },
      "default": {}
    },
    "mail_from": {
      "type": "string",
      "description": "Email remitente para notificaciones"
    },
    "mail_host": {
      "type": "string",
      "description": "Host del servidor SMTP"
    },
    "mail_port": {
      "type": "number",
      "description": "Puerto SMTP"
    },
    "mail_user": {
      "type": "string",
      "description": "Usuario SMTP"
    },
    "mail_password": {
      "type": "string",
      "description": "Contrase\u00f1a SMTP"
    },
    "whatsapp_token": {
      "type": "string",
      "description": "Token de WhatsApp Cloud API"
    },
    "whatsapp_phone_id": {
      "type": "string",
      "description": "Phone Number ID de WhatsApp Cloud API"
    },
    "printer_personal": {
      "type": "string",
      "description": "Nombre/etiqueta de la impresora asignada para acreditaciones personales"
    },
    "printer_vehicular": {
      "type": "string",
      "description": "Nombre/etiqueta de la impresora asignada para credenciales de estacionamiento / vehicular"
    },
    "role_access": {
      "type": "object",
      "description": "Mapa de path de m\u00f3dulo a array de roles con acceso permitido"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Zonas de control de acceso configurables"
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Puertas / puntos de control de acceso configurables"
    },
    "event_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Fases de evento configurables (armado, show, desarme, etc.)"
    },
    "employment_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Tipos de contrataci\u00f3n configurables"
    },
    "person_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Tipos de persona configurables"
    },
    "default_grace_hours": {
      "type": "number",
      "default": 4,
      "description": "Horas de gracia por defecto para nuevos eventos"
    },
    "enabled_modules": {
      "type": "object",
      "description": "Mapa de m\u00f3dulos activables/desactivables desde configuraci\u00f3n (whatsapp, etc.)",
      "default": {
        "whatsapp": false
      }
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}