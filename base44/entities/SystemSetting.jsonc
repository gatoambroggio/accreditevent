{
  "name": "SystemSetting",
  "type": "object",
  "properties": {
    "system_name": {
      "type": "string",
      "description": "Nombre del sistema mostrado en la barra lateral"
    },
    "organization_name": {
      "type": "string",
      "description": "Nombre de la organizaci\u00f3n"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logo del sistema"
    },
    "mail_from": {
      "type": "string",
      "description": "Email remitente para notificaciones"
    },
    "mail_host": {
      "type": "string",
      "description": "Host del servidor SMTP"
    },
    "mail_port": {
      "type": "number",
      "description": "Puerto SMTP"
    },
    "mail_user": {
      "type": "string",
      "description": "Usuario SMTP"
    },
    "mail_password": {
      "type": "string",
      "description": "Contrase\u00f1a SMTP"
    },
    "whatsapp_token": {
      "type": "string",
      "description": "Token de WhatsApp Cloud API"
    },
    "whatsapp_phone_id": {
      "type": "string",
      "description": "Phone Number ID de WhatsApp Cloud API"
    },
    "role_access": {
      "type": "object",
      "description": "Mapa de path de m\u00f3dulo a array de roles con acceso permitido"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Zonas de control de acceso configurables"
    },
    "event_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Fases de evento configurables (armado, show, desarme, etc.)"
    },
    "employment_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Tipos de contrataci\u00f3n configurables"
    },
    "person_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Tipos de persona configurables"
    },
    "default_grace_hours": {
      "type": "number",
      "default": 4,
      "description": "Horas de gracia por defecto para nuevos eventos"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}