{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "person_id": {
      "type": "string",
      "description": "Persona due\u00f1a del veh\u00edculo"
    },
    "person_name": {
      "type": "string",
      "description": "Nombre de la persona (denormalizado)"
    },
    "brand": {
      "type": "string",
      "description": "Marca del veh\u00edculo"
    },
    "model": {
      "type": "string",
      "description": "Modelo del veh\u00edculo"
    },
    "plate": {
      "type": "string",
      "description": "Patente del veh\u00edculo"
    },
    "color": {
      "type": "string",
      "description": "Color del veh\u00edculo"
    },
    "parking_sector": {
      "type": "string",
      "description": "Sector de estacionamiento asignado (coincide con el value de ParkingSector)"
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de eventos asignados al veh\u00edculo"
    },
    "event_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nombres de eventos (denormalizado)"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "person_id",
    "brand",
    "model",
    "plate"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_ids": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_ids": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_ids": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_ids": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}