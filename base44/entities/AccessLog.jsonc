{
  "name": "AccessLog",
  "type": "object",
  "properties": {
    "accreditation_id": {
      "type": "string",
      "description": "Acreditaci\u00f3n validada"
    },
    "person_name": {
      "type": "string",
      "description": "Nombre de la persona (denormalizado)"
    },
    "badge_code": {
      "type": "string",
      "description": "C\u00f3digo de credencial o patente (denormalizado)"
    },
    "event_id": {
      "type": "string",
      "description": "Evento asociado al acceso"
    },
    "event_name": {
      "type": "string",
      "description": "Nombre del evento (denormalizado)"
    },
    "company": {
      "type": "string",
      "description": "Empresa del evento (denormalizado para RLS)"
    },
    "verified_by": {
      "type": "string",
      "description": "Usuario que valid\u00f3 el acceso"
    },
    "pda_number": {
      "type": "string",
      "description": "N\u00famero/identificador de la PDA que registr\u00f3 el acceso"
    },
    "method": {
      "type": "string",
      "enum": [
        "biometric",
        "manual"
      ],
      "default": "biometric",
      "description": "M\u00e9todo de verificaci\u00f3n"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "person",
        "vehicle"
      ],
      "default": "person",
      "description": "Tipo de recurso validado (persona o veh\u00edculo)"
    },
    "zone": {
      "type": "string",
      "description": "Zona(s) de control de acceso (separadas por coma)"
    },
    "door": {
      "type": "string",
      "description": "Puerta o punto de control donde se registr\u00f3 el acceso"
    },
    "result": {
      "type": "string",
      "enum": [
        "granted",
        "denied"
      ],
      "default": "granted",
      "description": "Resultado del intento de acceso"
    },
    "denied_reason": {
      "type": "string",
      "enum": [
        "zone",
        "phase",
        "not_found",
        "blocked",
        ""
      ],
      "default": "",
      "description": "Motivo de denegaci\u00f3n cuando result=denied: zone/fase (rechazado), not_found (acceso incorrecto), blocked (acreditaci\u00f3n cancelada/deshabilitada)"
    },
    "access_level": {
      "type": "string",
      "description": "Nivel de acceso de la persona o sector del veh\u00edculo"
    }
  },
  "required": [
    "accreditation_id",
    "method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "control"
          }
        },
        {
          "user_condition": {
            "role": "pda"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "control"
          }
        },
        {
          "user_condition": {
            "role": "pda"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    }
  }
}