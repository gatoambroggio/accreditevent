{
  "name": "AccessLog",
  "type": "object",
  "properties": {
    "accreditation_id": {
      "type": "string",
      "description": "Acreditaci\u00f3n validada"
    },
    "person_name": {
      "type": "string",
      "description": "Nombre de la persona (denormalizado)"
    },
    "badge_code": {
      "type": "string",
      "description": "C\u00f3digo de credencial (denormalizado)"
    },
    "event_id": {
      "type": "string",
      "description": "Evento asociado al acceso"
    },
    "event_name": {
      "type": "string",
      "description": "Nombre del evento (denormalizado)"
    },
    "verified_by": {
      "type": "string",
      "description": "Usuario que valid\u00f3 el acceso"
    },
    "method": {
      "type": "string",
      "enum": [
        "biometric",
        "manual"
      ],
      "default": "biometric",
      "description": "M\u00e9todo de verificaci\u00f3n"
    },
    "zone": {
      "type": "string",
      "description": "Zona(s) de control de acceso (separadas por coma)"
    },
    "result": {
      "type": "string",
      "enum": [
        "granted",
        "denied"
      ],
      "default": "granted",
      "description": "Resultado del intento de acceso"
    },
    "access_level": {
      "type": "string",
      "description": "Nivel de acceso de la persona"
    }
  },
  "required": [
    "accreditation_id",
    "method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "productora"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.event_id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    }
  }
}