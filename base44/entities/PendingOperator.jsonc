{
  "name": "PendingOperator",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email del operador invitado (lowercase)"
    },
    "company": {
      "type": "string",
      "description": "Empresa productora a la que se vincular\u00e1 el operador"
    },
    "desired_role": {
      "type": "string",
      "default": "operador",
      "description": "Rol que se aplicar\u00e1 al usuario cuando complete el registro (pda, operador, control, barra, etc.)"
    },
    "assigned_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Eventos asignados que se aplicar\u00e1n al registrar"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "M\u00f3dulos permitidos que se aplicar\u00e1n al registrar"
    },
    "invite_url": {
      "type": "string",
      "description": "Link de registro prellenado para compartir manualmente"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed"
      ],
      "default": "pending",
      "description": "Estado de la asignaci\u00f3n pendiente"
    },
    "bar_id": {
      "type": "string",
      "description": "Barra asignada al operador de barra (cuando desired_role=barra)"
    },
    "bar_event_id": {
      "type": "string",
      "description": "Evento de la barra asignada (denormalizado)"
    },
    "bar_username": {
      "type": "string",
      "description": "Usuario libre del operador de barra (ej. B1)"
    },
    "bar_password": {
      "type": "string",
      "description": "Contrase\u00f1a inicial a setear al confirmar el registro del operador de barra (transitoria: se limpia tras aplicarse)"
    }
  },
  "required": [
    "email",
    "company"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "productora"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}