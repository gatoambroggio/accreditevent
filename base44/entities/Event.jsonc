{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del evento"
    },
    "venue": {
      "type": "string",
      "description": "Sede o lugar del evento"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo del evento para credenciales"
    },
    "start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de inicio"
    },
    "end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de fin"
    },
    "grace_hours": {
      "type": "number",
      "default": 4,
      "description": "Horas extra de acceso tras finalizar el evento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft",
      "description": "Estado del evento"
    }
  },
  "required": [
    "name"
  ]
}