{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del evento"
    },
    "venue": {
      "type": "string",
      "description": "Sede o lugar del evento"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo del evento para credenciales"
    },
    "company": {
      "type": "string",
      "description": "Empresa a la que pertenece el evento"
    },
    "start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Show - fecha y hora de inicio"
    },
    "end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Show - fecha y hora de fin"
    },
    "show_days": {
      "type": "number",
      "default": 1,
      "description": "Cantidad de d\u00edas de show del evento (1 a 6). Define los d\u00edas seleccionables al acreditar."
    },
    "armado_start": {
      "type": "string",
      "format": "date-time",
      "description": "Armado - inicio"
    },
    "armado_end": {
      "type": "string",
      "format": "date-time",
      "description": "Armado - fin"
    },
    "desarme_start": {
      "type": "string",
      "format": "date-time",
      "description": "Desarme - inicio"
    },
    "desarme_end": {
      "type": "string",
      "format": "date-time",
      "description": "Desarme - fin"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft",
      "description": "Estado del evento"
    },
    "pickup_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de retiro de credenciales"
    },
    "pickup_start_time": {
      "type": "string",
      "description": "Hora de inicio del retiro"
    },
    "pickup_end_time": {
      "type": "string",
      "description": "Hora de fin del retiro"
    },
    "pickup_address": {
      "type": "string",
      "description": "Direcci\u00f3n de retiro de credenciales"
    },
    "pickup_lat": {
      "type": "number",
      "description": "Latitud del punto de retiro"
    },
    "pickup_lng": {
      "type": "number",
      "description": "Longitud del punto de retiro"
    },
    "assigned_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de usuarios asignados a este evento"
    },
    "insurance_non_repetition_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Cl\u00e1usulas de no repetici\u00f3n que la p\u00f3liza debe contener (texto libre, varias)"
    },
    "insurance_insured_amount": {
      "type": "number",
      "description": "Monto asegurado m\u00ednimo requerido por el evento"
    },
    "parking_capacities": {
      "type": "object",
      "description": "Capacidad m\u00e1xima de veh\u00edculos por sector para este evento ({ sectorValue: number })",
      "default": {}
    },
    "bar_sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Sectores/ubicaciones del evento para barras (ej. General, VIP). Se definen en el men\u00fa del evento; el POS de barra usa un selector para cambiar los precios seg\u00fan el sector elegido."
    },
    "custom_fields": {
      "type": "object",
      "description": "Campos personalizados definidos por el administrador",
      "default": {}
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "operador"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "pda"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    }
  }
}