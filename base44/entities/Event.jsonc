{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del evento"
    },
    "venue": {
      "type": "string",
      "description": "Sede o lugar del evento"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo del evento para credenciales"
    },
    "company": {
      "type": "string",
      "description": "Empresa a la que pertenece el evento"
    },
    "start_at": {
      "type": "string",
      "format": "date-time",
      "description": "Show - fecha y hora de inicio"
    },
    "end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Show - fecha y hora de fin"
    },
    "armado_start": {
      "type": "string",
      "format": "date-time",
      "description": "Armado - inicio"
    },
    "armado_end": {
      "type": "string",
      "format": "date-time",
      "description": "Armado - fin"
    },
    "desarme_start": {
      "type": "string",
      "format": "date-time",
      "description": "Desarme - inicio"
    },
    "desarme_end": {
      "type": "string",
      "format": "date-time",
      "description": "Desarme - fin"
    },
    "grace_hours": {
      "type": "number",
      "default": 4,
      "description": "Horas extra de acceso tras finalizar el evento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft",
      "description": "Estado del evento"
    },
    "pickup_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de retiro de credenciales"
    },
    "pickup_start_time": {
      "type": "string",
      "description": "Hora de inicio del retiro"
    },
    "pickup_end_time": {
      "type": "string",
      "description": "Hora de fin del retiro"
    },
    "pickup_address": {
      "type": "string",
      "description": "Direcci\u00f3n de retiro de credenciales"
    },
    "pickup_lat": {
      "type": "number",
      "description": "Latitud del punto de retiro"
    },
    "pickup_lng": {
      "type": "number",
      "description": "Longitud del punto de retiro"
    },
    "assigned_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de usuarios asignados a este evento"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "id": {
            "$in": "{{user.data.assigned_event_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    }
  }
}