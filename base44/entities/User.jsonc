{
  "properties": {
    "role": {
      "type": "string",
      "description": "Rol del usuario en el sistema de acreditaciones",
      "enum": [
        "superadmin",
        "admin",
        "coordinator",
        "control",
        "provider"
      ],
      "default": "provider"
    },
    "assigned_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de eventos a los que el usuario tiene acceso"
    },
    "company": {
      "type": "string",
      "description": "Empresa a la que pertenece el usuario"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}