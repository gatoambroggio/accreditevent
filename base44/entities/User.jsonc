{
  "properties": {
    "role": {
      "type": "string",
      "description": "Rol del usuario en el sistema de acreditaciones",
      "enum": [
        "productora",
        "superadmin",
        "admin",
        "coordinator",
        "control",
        "operador",
        "provider",
        "empresa"
      ],
      "default": "provider"
    },
    "assigned_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de eventos a los que el usuario tiene acceso"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "M\u00f3dulos (rutas) permitidos para este usuario. Vac\u00edo = sin restricci\u00f3n (seg\u00fan rol)."
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el usuario est\u00e1 bloqueado y no puede iniciar sesi\u00f3n"
    },
    "company": {
      "type": "string",
      "description": "Empresa a la que pertenece el usuario"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "superadmin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "productora"
              }
            },
            {
              "data.company": "{{user.data.company}}"
            }
          ]
        }
      ]
    }
  }
}